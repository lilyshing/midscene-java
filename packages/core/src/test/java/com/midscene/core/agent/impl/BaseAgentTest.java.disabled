package com.midscene.core.agent.impl;

import com.midscene.core.agent.Agent;
import com.midscene.core.cache.AIModelCache;
import com.midscene.core.cache.UiContextCache;
import com.midscene.core.model.TaskResult;
import com.midscene.core.model.TaskStatus;
import com.midscene.core.service.AIModelService;
import com.midscene.core.service.InsightEngine;
import com.midscene.core.service.TaskExecutor;
import com.midscene.shared.model.ai.*;
import com.midscene.shared.platform.ElementLocator;
import com.midscene.shared.platform.PlatformInfo;
import com.midscene.shared.platform.PlatformInterface;
import com.midscene.shared.platform.UiContext;
import com.midscene.shared.platform.UiElement;
import org.junit.Before;
import org.junit.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;

import java.util.*;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.TimeUnit;

import static org.junit.Assert.*;
import static org.mockito.Mockito.*;

public class BaseAgentTest {

    @Mock
    private PlatformInterface platform;
    @Mock
    private AIModelService aiModelService;
    @Mock
    private InsightEngine insightEngine;
    @Mock
    private TaskExecutor taskExecutor;
    @Mock
    private PlatformInfo platformInfo;
    @Mock
    private UiContext uiContext;
    @Mock
    private UiElement uiElement;
    @Mock
    private AIModelCache aiModelCache;
    @Mock
    private UiContextCache uiContextCache;

    private BaseAgent agent;

    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
        
        // 设置模拟对象的行为
        when(platform.getPlatformInfo()).thenReturn(platformInfo);
        when(platformInfo.getType()).thenReturn(PlatformInfo.PlatformType.WEB);
        when(platform.getCurrentUiContext()).thenReturn(CompletableFuture.completedFuture(uiContext));
        when(uiElement.getId()).thenReturn("test-element-id");
        when(uiElement.getType()).thenReturn("BUTTON");
        when(uiElement.getText()).thenReturn("Test Button");
        
        // 创建被测试对象
        agent = new BaseAgent(platform, aiModelService, insightEngine, taskExecutor);
    }

    @Test
    void testConstructor() {
        // 验证构造函数成功初始化对象
        assertNotNull(agent);
        // 验证父类字段被正确初始化
        assertNotNull(((Agent)agent).getPlatform());
        assertNotNull(((Agent)agent).getAiModelService());
        assertNotNull(((Agent)agent).getInsightEngine());
        assertNotNull(((Agent)agent).getTaskExecutor());
    }

    @Test
    void testGetActiveTaskCount_initialState() {
        // 测试初始状态下活跃任务数量为0
        assertEquals(0, agent.getActiveTaskCount());
    }

    @Test
    void testAiAction_withCacheHit() throws Exception {
        // 准备测试数据
        String instruction = "点击登录按钮";
        AIActionRequest request = AIActionRequest.builder()
                .task(instruction)
                .uiContext(uiContext)
                .agentType("WEB")
                .build();
        
        List<Map<String, Object>> actionPlan = new ArrayList<>();
        Map<String, Object> action = new HashMap<>();
        action.put("action", "tap");
        Map<String, Object> params = new HashMap<>();
        params.put("elementId", "login-button");
        action.put("params", params);
        actionPlan.add(action);
        
        AIActionResult cachedResult = AIActionResult.builder()
                .intent("{\"type\":\"CLICK\",\"target\":\"login-button\"}")
                .actionPlan(actionPlan)
                .build();
        
        // 设置模拟行为
        when(aiModelService.getCachedResult(request)).thenReturn(cachedResult);
        
        TaskResult expectedResult = TaskResult.builder()
                .status(TaskStatus.COMPLETED)
                .message("Task completed successfully")
                .build();
        when(taskExecutor.executeTask(eq("tap"), anyMap())).thenReturn(CompletableFuture.completedFuture(expectedResult));
        
        // 执行测试
        CompletableFuture<TaskResult> resultFuture = agent.aiAction(instruction);
        TaskResult result = resultFuture.get(5, TimeUnit.SECONDS);
        
        // 验证结果
        assertNotNull(result);
        assertEquals(TaskStatus.COMPLETED, result.getStatus());
        assertTrue(result.getMessage().contains("from cache"));
        
        // 验证交互
        verify(aiModelService).getCachedResult(request);
    }

    @Test
    void testAiAction_withCacheMiss() throws Exception {
        // 准备测试数据
        String instruction = "点击注册按钮";
        AIActionRequest request = AIActionRequest.builder()
                .task(instruction)
                .uiContext(uiContext)
                .agentType("WEB")
                .build();
        
        Map<String, Object> intent = new HashMap<>();
        intent.put("type", "CLICK");
        intent.put("target", "register-button");
        
        List<Map<String, Object>> actionPlan = new ArrayList<>();
        Map<String, Object> action = new HashMap<>();
        action.put("action", "tap");
        Map<String, Object> params = new HashMap<>();
        params.put("elementId", "register-button");
        action.put("params", params);
        actionPlan.add(action);
        
        // 设置模拟行为
        when(aiModelService.getCachedResult(request)).thenReturn(null);
        when(insightEngine.understandIntent(eq(instruction), anyMap()))
                .thenReturn(CompletableFuture.completedFuture(intent));
        when(insightEngine.generateActionPlan(eq(intent), isNull())).thenReturn(CompletableFuture.completedFuture(actionPlan));
        
        TaskResult expectedResult = TaskResult.builder()
                .status(TaskStatus.COMPLETED)
                .message("Task completed successfully")
                .build();
        when(taskExecutor.executeTask(eq("tap"), anyMap())).thenReturn(CompletableFuture.completedFuture(expectedResult));
        
        // 执行测试
        CompletableFuture<TaskResult> resultFuture = agent.aiAction(instruction);
        TaskResult result = resultFuture.get(5, TimeUnit.SECONDS);
        
        // 验证结果
        assertNotNull(result);
        assertEquals(TaskStatus.COMPLETED, result.getStatus());
        assertFalse(((Boolean) result.getData().get("fromCache")));
        
        // 验证交互
        verify(aiModelService).cacheResult(any(AIActionRequest.class), any(AIActionResult.class));
    }

