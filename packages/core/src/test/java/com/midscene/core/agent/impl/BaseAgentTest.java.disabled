    @Test
    void testExtractData_withCacheMiss() throws Exception {
        // 准备测试数据
        String targetDescription = "产品名称";
        ExtractDataRequest request = ExtractDataRequest.builder()
                .task(targetDescription)
                .uiContext(uiContext)
                .agentType("WEB")
                .build();
        
        List<UiElement> elements = Collections.singletonList(uiElement);
        
        // 设置模拟行为
        when(aiModelService.getCachedResult(request)).thenReturn(null);
        when(insightEngine.findElementsByDescription(eq(uiContext), eq(targetDescription)))
                .thenReturn(CompletableFuture.completedFuture(elements));
        
        // 执行测试
        CompletableFuture<String> resultFuture = agent.extractData(targetDescription);
        String result = resultFuture.get(5, TimeUnit.SECONDS);
        
        // 验证结果
        assertNotNull(result);
        assertTrue(result.contains("Element ID: test-element-id"));
        assertTrue(result.contains("Type: BUTTON"));
        assertTrue(result.contains("Text: Test Button"));
        
        // 验证交互
        verify(aiModelService).cacheResult(any(ExtractDataRequest.class), any(ExtractDataResult.class));
    }

    @Test
    void testCancelAllTasks() throws Exception {
        // 首先创建一些活跃任务
        String instruction1 = "任务1";
        String instruction2 = "任务2";
        
        // 设置模拟行为使任务不立即完成
        AIActionRequest request = AIActionRequest.builder()
                .task(instruction1)
                .uiContext(uiContext)
                .agentType("WEB")
                .build();
        
        when(aiModelService.getCachedResult(request)).thenReturn(null);
        when(insightEngine.understandIntent(anyString(), anyMap()))
                .thenReturn(CompletableFuture.supplyAsync(() -> {
                    try { Thread.sleep(10000); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
                    return new HashMap<String, Object>();
                }));
        
        // 执行两个异步任务
        agent.aiAction(instruction1);
        agent.aiAction(instruction2);
        
        // 验证有活跃任务
        assertTrue(agent.getActiveTaskCount() > 0);
        
        // 取消所有任务
        agent.cancelAllTasks();
        
        // 验证没有活跃任务
        assertEquals(0, agent.getActiveTaskCount());
    }
}