                .build();
        
        AITapResult cachedResult = AITapResult.builder()
                .tapTarget(new ElementLocator(ElementLocator.LocatorType.ID, "login-button"))
                .build();
        
        // 设置模拟行为
        when(aiModelService.getCachedResult(request)).thenReturn(cachedResult);
        
        TaskResult expectedResult = TaskResult.builder()
                .status(TaskStatus.COMPLETED)
                .message("Tap completed successfully")
                .build();
        when(taskExecutor.executeTask(eq("tap"), anyMap())).thenReturn(CompletableFuture.completedFuture(expectedResult));
        
        // 执行测试
        CompletableFuture<TaskResult> resultFuture = agent.aiTap(targetDescription);
        TaskResult result = resultFuture.get(5, TimeUnit.SECONDS);
        
        // 验证结果
        assertNotNull(result);
        assertEquals(TaskStatus.COMPLETED, result.getStatus());
        assertTrue(result.getMessage().contains("from cache"));
    }

    @Test
    void testAiTap_withCacheMiss() throws Exception {
        // 准备测试数据
        String targetDescription = "注册按钮";
        AITapRequest request = AITapRequest.builder()
                .task(targetDescription)
                .uiContext(uiContext)
                .agentType("WEB")
                .build();
        
        List<UiElement> elements = Collections.singletonList(uiElement);
        
        // 设置模拟行为
        when(aiModelService.getCachedResult(request)).thenReturn(null);
        when(insightEngine.findElementsByDescription(eq(uiContext), eq(targetDescription)))
                .thenReturn(CompletableFuture.completedFuture(elements));
        
        TaskResult expectedResult = TaskResult.builder()
                .status(TaskStatus.COMPLETED)
                .message("Tap completed successfully")
                .build();
        when(taskExecutor.executeTask(eq("tap"), anyMap())).thenReturn(CompletableFuture.completedFuture(expectedResult));
        
        // 执行测试
        CompletableFuture<TaskResult> resultFuture = agent.aiTap(targetDescription);
        TaskResult result = resultFuture.get(5, TimeUnit.SECONDS);
        
        // 验证结果
        assertNotNull(result);
        assertEquals(TaskStatus.COMPLETED, result.getStatus());
        assertFalse(((Boolean) result.getData().get("fromCache")));
        
        // 验证交互
        verify(aiModelService).cacheResult(any(AITapRequest.class), any(AITapResult.class));
    }

    @Test
    void testAiTap_noElementsFound() throws Exception {
        // 准备测试数据
        String targetDescription = "不存在的按钮";
        AITapRequest request = AITapRequest.builder()
                .task(targetDescription)
                .uiContext(uiContext)
                .agentType("WEB")
                .build();
        
        // 设置模拟行为
        when(aiModelService.getCachedResult(request)).thenReturn(null);
        when(insightEngine.findElementsByDescription(eq(uiContext), eq(targetDescription)))
                .thenReturn(CompletableFuture.completedFuture(Collections.emptyList()));
        
        // 执行测试
        CompletableFuture<TaskResult> resultFuture = agent.aiTap(targetDescription);
        TaskResult result = resultFuture.get(5, TimeUnit.SECONDS);
        
        // 验证结果
        assertNotNull(result);
        assertEquals(TaskStatus.FAILED, result.getStatus());
        assertTrue(result.getMessage().contains("No elements found"));
    }

