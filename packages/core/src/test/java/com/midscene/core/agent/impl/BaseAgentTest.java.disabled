                .build();
        
        ExtractDataResult cachedResult = ExtractDataResult.builder()
                .data("$99.99")
                .build();
        
        // 设置模拟行为
        when(aiModelService.getCachedResult(request)).thenReturn(cachedResult);
        
        // 执行测试
